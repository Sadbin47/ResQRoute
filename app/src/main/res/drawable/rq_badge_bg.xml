<?xml version="1.0" encoding="utf-8"?>
<!-- The offline badge: a pill on the card surface with the same hairline border as a card, so it
     reads as part of the panel rather than floating over it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/rq_card_surface" />
    <corners android:radius="@dimen/rq_pill_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/rq_card_border" />
</shape>
